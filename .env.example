# ─── Application ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in values before running locally.
# NEVER commit the .env file.

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=netmind
POSTGRES_USER=netmind
POSTGRES_PASSWORD=change_me_in_local_env

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_in_local_env

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_TELEMETRY=netmind.telemetry
KAFKA_TOPIC_ALARMS=netmind.alarms
KAFKA_TOPIC_TOPOLOGY=netmind.topology
KAFKA_TOPIC_CONFIG_CHANGES=netmind.config_changes
KAFKA_TOPIC_ANOMALIES=netmind.anomalies
KAFKA_TOPIC_INCIDENTS=netmind.incidents

# ─── Security ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── API ─────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
# Comma-separated allowed origins for CORS
API_CORS_ORIGINS=http://localhost:3000

# ─── Ollama (LLM backend) ─────────────────────────────────────────────────────
OLLAMA_HOST=http://ollama:11434
# Default model pulled on first run
OLLAMA_MODEL=llama3.2:3b

# ─── MLflow ──────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=netmind-anomaly-detection

# ─── Environment ─────────────────────────────────────────────────────────────
# Options: development | production
APP_ENV=development
LOG_LEVEL=INFO

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AGENT=10/minute

# ─── Frontend ────────────────────────────────────────────────────────────────
# Used by Next.js at build time (prefix NEXT_PUBLIC_ for client-side)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
